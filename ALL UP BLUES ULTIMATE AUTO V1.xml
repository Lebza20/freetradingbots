          <!-- Evaluate Over 1 condition (Volatility 1 symbols). If TRUE, purchase DIGITOVER with prediction 1 -->
          <block type="controls_if" id="if_over1_condition">
            <value name="IF0">
              <block type="logic_operation" id="and_over1">
                <field name="OP">AND</field>
                <value name="A">
                  <!-- 0% < 9 and 1% < 9 -->
                  <block type="logic_operation">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="digit_percent">
                            <field name="DIGIT">0</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number"><field name="NUM">9</field></block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="digit_percent">
                            <field name="DIGIT">1</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number"><field name="NUM">9</field></block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>

                <value name="B">
                  <!-- digits 3,4,5 > 10 -->
                  <block type="logic_operation">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare">
                        <field name="OP">GT</field>
                        <value name="A"><block type="digit_percent"><field name="DIGIT">3</field></block></value>
                        <value name="B"><block type="math_number"><field name="NUM">10</field></block></value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_operation"><field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_compare"><field name="OP">GT</field>
